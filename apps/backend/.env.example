GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Required, 16+ chars. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_flask_secret_key
# Optional: separate key for encrypting stored Google tokens (defaults to SECRET_KEY)
TOKEN_ENCRYPTION_KEY=
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_gmail_app_password
# Optional: enables Claude document analysis and checklist review (keyword heuristics otherwise)
ANTHROPIC_API_KEY=
# Optional: defaults to claude-haiku-5-5 (cheap); e.g. claude-opus-5-5 for deeper reviews
ANTHROPIC_MODEL=
# Optional: AI calls per UTC day before falling back to heuristics (default 200)
AI_DAILY_LIMIT=
# Production: public URL when the host doesn't announce it (Render/Railway do)
PUBLIC_URL=
# 1 = create the demo room (demo@acmecorp.dev) on startup if missing
DEMO_SEED=
